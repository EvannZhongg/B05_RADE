{
  "max_same_tool_calls": 5,
  "output_reserve_tokens": 8192,
  "max_generation_tokens": null,
  "provider": {
    "request_timeout_seconds": 300,
    "max_retries": 2
  },
  "scene_task": {
    "budget_seconds": 600,
    "baseline_strategy_id": "marginal_greedy",
    "baseline_config_id": "default"
  },
  "context": {
    "compression": {
      "enabled": true,
      "trigger_ratio": null,
      "keep_recent_units": 8,
      "user_anchor_token_budget": 2000
    }
  },
  "main_agent": {
    "tools": {
      "read_file": true,
      "apply_patch": false,
      "edit_file": true,
      "write_file": true,
      "search_files": false,
      "list_directory": true,
      "shell": true,
      "subagent": true,
      "job_control": true
    }
  },
  "subagent_roles": {
    "researcher": {
      "enabled": false,
      "description": "Read and search the workspace to answer a question. Prefer delegating complex, independent investigation tasks to this role so the main agent can continue other work in parallel. Cannot modify files.",
      "tools": {
        "read_file": true,
        "search_files": true,
        "list_directory": true
      },
      "mcp": {}
    }
  },
  "memory": {
    "enabled": true,
    "max_tokens": 3000
  },
  "mcp": {
    "enabled": true,
    "servers": {}
  }
}
